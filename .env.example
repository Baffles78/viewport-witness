# ViewportWitness environment configuration
# Copy to .env and fill in values. Never commit .env to git.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Storage ---
DATA_DIR=./data
SCREENSHOTS_DIR=./data/screenshots
DB_PATH=./data/vw.db

# --- Payment mode: test | testnet | production ---
# Default is 'test' (no payment required). Change only after mainnet review.
PAYMENT_MODE=test

# --- Mainnet guard: must be explicitly set to 'true' to enable production payments ---
# NEVER set this to true without completing the independent review gate.
ENABLE_MAINNET_PAYMENTS=false

# Add Solana as a second accepted rail. Keep false until its settlement test
# and independent release review pass.
ENABLE_SOLANA_PAYMENTS=false

# --- x402 facilitator (CDP credentials required for paid modes) ---
# Coinbase CDP API key credentials (never log or commit these values).
# Obtain from the Coinbase Developer Platform dashboard.
# CDP_API_KEY_ID is the key name, e.g. organizations/ORG/apiKeys/KEY
# CDP_API_KEY_SECRET is the PEM-formatted EC private key from the dashboard.
# CDP_API_KEY_ID=organizations/YOUR_ORG/apiKeys/YOUR_KEY
# CDP_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# Private HMAC secret used only to create stable anonymous customer identifiers.
# Generate at least 32 random characters. Never reuse a wallet or CDP key.
# CUSTOMER_HASH_SECRET=
# The official SDK defaults to Coinbase's production hosted-facilitator endpoint.
# Override only for a reviewed CDP staging/canary endpoint.
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# --- Revenue address (public, no private key) ---
PAY_TO=0xe5fa9502bd9f32a0fc90f2c809296b4835c2c400
# Public destinations are separate so changing PAYMENT_MODE cannot accidentally
# reuse the testing receiver in production. Never put private material here.
SOLANA_TEST_PAY_TO=AwnqYWr32DUJvk4XKxfUSpVVYcoUuMFNp8XoBShm5qSS
SOLANA_REVENUE_PAY_TO=EcgBX5ydNsGfJDrmW2qzNtJenDud8sNGSZBtt3XH2WJk
PRICE_USDC=0.08
VERIFY_PRICE_USDC=0.10
COMPARE_PRICE_USDC=0.12
EXTRACT_PRICE_USDC=0.005
SECURITY_PRICE_USDC=0.05

# --- Retention and storage ---
RETENTION_DAYS=7
MAX_STORAGE_GB=10

# --- Worker ---
WORKER_TIMEOUT_MS=120000

# --- Logging ---
LOG_LEVEL=info
